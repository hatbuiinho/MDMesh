{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mdm.local/proto/v1/payloads/config-apply.schema.json",
  "title": "ConfigApplyPayload",
  "type": "object",
  "additionalProperties": true,
  "required": ["revision", "configurationId"],
  "properties": {
    "revision": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "sha256 hex of the canonical JSON of this object without `revision`" },
    "configurationId": { "type": "integer" },
    "policies": {
      "type": "object", "additionalProperties": { "type": "boolean" },
      "properties": { "wifi": {"type":"boolean"}, "bluetooth": {"type":"boolean"}, "usbStorage": {"type":"boolean"}, "screenshots": {"type":"boolean"} },
      "description": "Only keys the configuration manages are present. true = allowed/enabled."
    },
    "kiosk": {
      "type": "object", "additionalProperties": true,
      "description": "Present => ensure kiosk with this KioskApplyPayload. Absent = the configuration does not assert kiosk; the agent exits only if the previously applied configuration document had kiosk.",
      "properties": {
        "mode": { "enum": ["single", "launcher"] },
        "allowedPackages": { "type": "array", "items": { "type": "string" } },
        "pinPackage": { "type": "string" },
        "features": { "type": "object", "properties": { "home": {"type":"boolean"}, "recents": {"type":"boolean"}, "notifications": {"type":"boolean"}, "systemInfo": {"type":"boolean"}, "keyguard": {"type":"boolean"}, "lockButtons": {"type":"boolean"} } },
        "exitMode": { "enum": ["gesture", "visible", "remote"] },
        "password": { "type": "string" },
        "theme": { "type": "object", "properties": { "backgroundColor": {"type":"string"}, "textColor": {"type":"string"}, "iconSize": {"type":"string"} } }
      }
    },
    "applications": {
      "type": "object", "additionalProperties": false, "required": ["enforceAllowlist", "allowedPackages"],
      "properties": { "enforceAllowlist": { "type": "boolean" }, "allowedPackages": { "type": "array", "items": { "type": "string" }, "uniqueItems": true } },
      "description": "When enabled, hide launchable packages outside this allowlist. Agent and platform-critical packages are protected automatically."
    },
    "location": { "type": "object", "properties": { "mode": { "enum": ["passive", "active"] } } },
    "webAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "domains"
      ],
      "properties": {
        "mode": {
          "enum": [
            "OFF",
            "ALLOWLIST",
            "BLOCKLIST"
          ]
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
          },
          "uniqueItems": true
        },
        "scope": {
          "enum": [
            "ALL",
            "SELECTED"
          ]
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)+$"
          },
          "uniqueItems": true
        },
        "policyHash": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "rules": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "mode",
              "scope",
              "packages",
              "domains"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,80}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "mode": {
                "enum": [
                  "BLOCKLIST",
                  "ALLOWLIST"
                ]
              },
              "scope": {
                "enum": [
                  "ALL",
                  "SELECTED"
                ]
              },
              "packages": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)+$"
                },
                "uniqueItems": true,
                "maxItems": 500
              },
              "domains": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"
                },
                "uniqueItems": true,
                "maxItems": 500
              }
            }
          }
        },
        "grants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "requestId",
              "domain",
              "packages"
            ],
            "properties": {
              "requestId": {
                "type": "integer"
              },
              "domain": {
                "type": "string",
                "maxLength": 253
              },
              "packages": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                },
                "description": "Exact package IDs; the explicit admin-selected device-wide scope is [\"*\"]."
              },
              "expiresAt": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Epoch milliseconds; null or absent means indefinite until revoked."
              }
            }
          }
        }
      }
    },
    "appUsage": {
      "type": "object", "additionalProperties": false, "required": ["timezone", "rules"],
      "properties": {
        "timezone": { "type": "string", "description": "IANA time-zone ID" },
        "rules": { "type": "array", "items": { "type": "object", "required": ["packageName", "action", "enabled", "allowedWindows"], "properties": {
          "id": { "type": "integer" }, "packageName": { "type": "string" },
          "dailyLimitMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
          "warningMinutes": { "type": "integer", "minimum": 0, "maximum": 120 },
          "action": { "const": "suspend" }, "enabled": { "type": "boolean" },
          "allowedWindows": { "type": "array", "items": { "type": "object", "required": ["days", "from", "to"], "properties": {
            "days": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 7 }, "minItems": 1, "uniqueItems": true },
            "from": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$" }, "to": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$" }
          } } }
        } } },
        "schedules": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "scope",
              "days",
              "from",
              "to"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "enabled": {
                "type": "boolean"
              },
              "scope": {
                "enum": [
                  "ALL",
                  "SELECTED"
                ]
              },
              "packages": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "exceptions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "days": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 7
                }
              },
              "from": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              "to": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              "warningMinutes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 60
              }
            }
          }
        },
        "overrides": { "type": "array", "items": { "type": "object", "required": ["packageName", "extraMinutes", "expiresAt"], "properties": {
          "packageName": { "type": "string" }, "extraMinutes": { "type": "integer", "minimum": 1 }, "expiresAt": { "type": "integer" }
        } } }
      }
    }
  }
}
